# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/copypastelearn?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Mux
MUX_TOKEN_ID="..."
MUX_TOKEN_SECRET="..."

# Lab Service
LAB_SERVICE_URL="http://localhost:4000"
LAB_SERVICE_API_KEY="dev-lab-service-key"

# Stripe (webhook validation)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Commerce — protected file storage (Vercel Blob)
# Auto-injected on Vercel when a Blob store is linked. For local dev, run:
#   vercel env pull apps/web/.env.local --environment=development
BLOB_READ_WRITE_TOKEN=""

# Commerce — transactional email (Resend)
RESEND_API_KEY="re_..."
COMMERCE_EMAIL_FROM="CopyPasteLearn <noreply@copypastelearn.com>"

# Commerce — rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Commerce — feature flags
# DO NOT enable Stripe Shared Payment Tokens at MVP (see FR-043 / A9)
ENABLE_STRIPE_SPT="false"

# Course labs (browser sessions and lab guides)
ENABLE_COURSE_LABS="false"

# Commerce — app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IndexNow (optional — enables instant search-engine ping on publish)
# Generate a 32-char hex key: openssl rand -hex 16
INDEXNOW_KEY=""

# Ad tags (optional). Each tag loads only after the visitor accepts
# marketing cookies, and only if its id is set here. Leave empty to disable.
# These are public ids (NEXT_PUBLIC_*), inlined at build time: redeploy after changing.
# Google Ads: tag id "AW-XXXXXXXXXX" (Google Ads > Goals > Conversions > tag setup)
NEXT_PUBLIC_GOOGLE_ADS_ID=""
# Google Ads conversion labels (the part after "AW-XXXXXXXXXX/" in send_to)
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=""
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=""
# Meta (Facebook) Pixel id (Events Manager > Data sources)
NEXT_PUBLIC_META_PIXEL_ID=""
# LinkedIn Insight Tag partner id (Campaign Manager > Analyze > Insight Tag)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
# LinkedIn conversion ids (Campaign Manager > Analyze > Conversion tracking, "event-specific" method)
NEXT_PUBLIC_LINKEDIN_PURCHASE_CONVERSION_ID=""
NEXT_PUBLIC_LINKEDIN_SIGNUP_CONVERSION_ID=""
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=""
# Reddit Pixel id (Reddit Ads > Events Manager), e.g. "a2_xxxxxxxxxx"
NEXT_PUBLIC_REDDIT_PIXEL_ID=""
