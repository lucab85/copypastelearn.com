{
  "site": "copypastelearn.com",
  "base": "https://www.copypastelearn.com",
  "role": "Course pages (Claude Code first)",
  "articlePrefix": "/blog/",
  "identity": {
    "person": true,
    "org": true
  },
  "social": {
    "siteHandles": [
      "@copypastelearn"
    ]
  },
  "analytics": {
    "gaId": "G-YN94VH0TPN",
    "inHtml": true
  },
  "allowBlockedBots": [
    "CCBot"
  ],
  "llms": {
    "mustInclude": [
      "Claude Code"
    ]
  },
  "pages": [
    {
      "path": "/courses/"
    },
    {
      "path": "/courses/claude-code-masterclass"
    }
  ],
  "sample": 20,
  "titleMax": 70,
  "$comment": "Expectations for scripts/verify-live.mjs (shared engine). Decisions of Nov 2, 2026: one role per site, one Person/Organization identity, X @TheLucaBerton, YouTube @BertonLuca, AI crawlers allowed.",
  "articleExclude": [
    "/blog/tag/",
    "/blog/category/",
    "/blog/page/"
  ]
}